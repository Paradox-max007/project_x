# ============================================================
# ASM Manpower Management System — environment configuration
# Backend: Supabase (PostgreSQL) · Hosting: Vercel
#
# Replace the [PLACEHOLDERS] below with your Supabase project's
# values: Supabase Dashboard -> Settings -> Database ->
# Connection string -> URI.
# ============================================================

# --- Runtime + pooled queries (used by the app / Vercel) ---
# Use the "Transaction" pooler URI (port 6543). The pgbouncer param
# makes Prisma compatible with Supabase's connection pooler.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# --- Direct connection (used by prisma db push / migrate / seed) ---
# Use the direct/session URI (port 5432) for schema changes.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Field-level encryption (passport / ID numbers, AES-256-GCM) ---
# IMPORTANT: set this BEFORE running `db:seed` the first time.
# Changing it later makes previously encrypted rows unreadable.
# Generate one with:  openssl rand -hex 32
ASM_SECRET_KEY="[REPLACE-WITH-LONG-RANDOM-STRING]"
